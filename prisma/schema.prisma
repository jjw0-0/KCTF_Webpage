// Prisma 스키마 파일
// 데이터베이스 구조(테이블, 컬럼, 관계)를 정의하고, TypeScript 타입을 자동 생성

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum CTFStatus {
  DRAFT
  SCHEDULED
  ONGOING
  PAUSED
  ENDED
}

enum CTFMode {
  INDIVIDUAL
  TEAM
}

enum ChallengeCategory {
  WEB
  WEB3
  REVERSING
  PWN
  CRYPTO
  FORENSICS
  MISC
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  teamMemberships TeamMember[]
  submissions     Submission[]

  @@map("users")
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  inviteCode  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members     TeamMember[]
  submissions Submission[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  isLeader  Boolean  @default(false)
  joinedAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("team_members")
}

model CTF {
  id          String    @id @default(cuid())
  name        String
  description String?
  mode        CTFMode
  status      CTFStatus @default(DRAFT)
  startTime   DateTime?
  endTime     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  challenges Challenge[]

  @@map("ctfs")
}

model Challenge {
  id          String            @id @default(cuid())
  ctfId       String
  title       String
  description String
  category    ChallengeCategory
  points      Int
  flag        String
  fileUrl     String?
  author      String?
  hints       String?
  isVisible   Boolean           @default(false)
  solveCount  Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  ctf         CTF        @relation(fields: [ctfId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@map("challenges")
}

model Submission {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  teamId      String?
  flag        String
  isCorrect   Boolean
  submittedAt DateTime @default(now())

  // Relations
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
  @@index([teamId])
  @@index([submittedAt])
  @@map("submissions")
}
