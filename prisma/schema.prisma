// Prisma 스키마 파일
// 데이터베이스 구조(테이블, 컬럼, 관계)를 정의하고, TypeScript 타입을 자동 생성

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum CTFStatus {
  DRAFT
  SCHEDULED
  ONGOING
  PAUSED
  ENDED
}

enum CTFMode {
  INDIVIDUAL
  TEAM
}

enum ChallengeDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ChallengeScoringMode {
  STATIC
  DYNAMIC
  LINEAR
}

enum DeploymentStatus {
  NONE
  QUEUED
  BUILDING
  READY
  FAILED
}

model User {
  id            String   @id @default(cuid())
  instancerId   Int      @unique @default(autoincrement())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  avatarData    String?
  role          UserRole @default(USER)
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  passwordUpdatedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  teamMemberships TeamMember[]
  submissions     Submission[]
  solves          Solve[]
  challengeInstance ChallengeInstance?

  @@map("users")
}

model ChallengeInstance {
  id            String   @id @default(cuid())
  userId        String   @unique
  challengeId   String
  instanceSlug  String
  token         String   @unique
  url           String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("challenge_instances")
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  inviteCode  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members     TeamMember[]
  submissions Submission[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  isLeader  Boolean  @default(false)
  joinedAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("team_members")
}

model CTF {
  id          String    @id @default(cuid())
  name        String
  description String?
  mode        CTFMode
  status      CTFStatus @default(DRAFT)
  startTime   DateTime?
  endTime     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  challenges Challenge[]
  categories Category[]

  @@map("ctfs")
}

model Category {
  id          String   @id @default(cuid())
  ctfId       String
  name        String
  slug        String
  shortName   String
  description String   @default("")
  accentColor String   @default("#4de0a7")
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ctf        CTF         @relation(fields: [ctfId], references: [id], onDelete: Cascade)
  challenges Challenge[]

  @@unique([ctfId, slug])
  @@index([ctfId, sortOrder])
  @@map("categories")
}

model Challenge {
  id            String              @id @default(cuid())
  ctfId         String
  title         String
  summary       String              @default("")
  description   String
  categoryId    String
  points        Int
  scoringMode   ChallengeScoringMode @default(STATIC)
  minimumPoints Int                  @default(50)
  decaySolves   Int                  @default(20)
  decrementPerSolve Int              @default(10)
  difficulty    ChallengeDifficulty @default(INTERMEDIATE)
  tags          String[]            @default([])
  flag          String?
  instanceSlug  String?             @unique
  usesVm        Boolean             @default(false)
  usesCompose   Boolean             @default(false)
  instancePort  Int?
  connectionUrl String?
  fileUrl       String?
  attachmentName String?
  attachmentMimeType String?
  attachmentSize Int?
  attachmentData Bytes?
  deploymentStatus DeploymentStatus @default(NONE)
  deploymentError String?
  deploymentUpdatedAt DateTime?
  author        String?
  hints         String?
  isVisible     Boolean             @default(false)
  solveCount    Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Relations
  ctf         CTF        @relation(fields: [ctfId], references: [id], onDelete: Cascade)
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  submissions Submission[]
  solves      Solve[]

  @@index([ctfId, categoryId, isVisible])
  @@map("challenges")
}

model Submission {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  teamId      String?
  flag        String
  isCorrect   Boolean
  submittedAt DateTime @default(now())

  // Relations
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
  @@index([teamId])
  @@index([submittedAt])
  @@map("submissions")
}

model Solve {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  points      Int
  solvedAt    DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId, solvedAt])
  @@index([solvedAt])
  @@map("solves")
}
