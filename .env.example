# 환경변수 템플릿 파일
# cp .env.example .env 후 실제 값으로 수정

# Database - PostgreSQL 연결 정보
POSTGRES_USER=kctf
POSTGRES_PASSWORD=kctfpassword
POSTGRES_DB=kctf
POSTGRES_PORT=5432
# Prisma가 사용하는 데이터베이스 연결 URL
DATABASE_URL=postgresql://kctf:kctfpassword@localhost:5432/kctf?schema=public

# NextAuth - 인증 시스템
NEXTAUTH_URL=http://localhost:3000
# 아래 명령어로 안전한 비밀키 생성: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-change-this-in-production

# Bundled Compose challenge instancer
DOMAIN=ctf.example.com
INSTANCER_URL=http://instancer:7000
KCTF_INSTANCER_TOKEN=change-this-instancer-token
INSTANCER_PUBLIC_HOST=chall.example.com
INSTANCER_TTL_MS=3600000
INSTANCER_PORT_MIN=10000
INSTANCER_PORT_MAX=19999
INSTANCER_MAX_MEMORY_MB=1024
INSTANCER_MAX_CPU=2
INSTANCER_MAX_PIDS=256
INSTANCER_INSTALL_AMD64_EMULATION=true

# Application - 애플리케이션 설정
APP_PORT=3000
KCTF_HOST_PORT=3020
NODE_ENV=development

# Nginx - 파일 다운로드 보안
# Nginx secure_link 모듈에서 사용하는 비밀키
SECURE_LINK_SECRET=your-secure-link-secret-change-this
