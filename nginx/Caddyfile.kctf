# Set DOMAIN when running Caddy, for example: DOMAIN=ctf.kknock.org.
{$DOMAIN:ctf.kknock.org} {
	encode zstd gzip
	log {
		output file /var/log/kctf/access.jsonl {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=0"
	}

	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:3020 {
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}
}
